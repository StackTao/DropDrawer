# Optional direct server settings. Compose sets container paths and its bind address.
DROPDRAWER_BIND=0.0.0.0:8080
DROPDRAWER_DB_PATH=./data/dropdrawer.db
DROPDRAWER_LOCAL_STORAGE=./data/blobs
# Optional per-file upload limit in bytes for server-local storage (10485760 = 10 MiB).
DROPDRAWER_LOCAL_MAX_FILE_BYTES=
DROPDRAWER_LOCAL_USER_QUOTA_BYTES=
DROPDRAWER_TTL_CLEANUP_SECS=300
DROPDRAWER_ALLOW_REGISTRATION=true
# Optional comma-separated list of allowed CORS origins (empty or * allows any origin).
DROPDRAWER_CORS_ORIGINS=
# Enable only behind a private reverse proxy that overwrites forwarding headers.
DROPDRAWER_TRUST_PROXY=false
RUST_LOG=info

# An empty value uses the persistent random secret next to the database.
DROPDRAWER_JWT_SECRET=

# Encrypts stored cloud drive credentials and other secrets (32 bytes: `openssl rand -hex 32`).
# An empty value uses the secret_key file next to the database. Back it up with the
# database and never change it: stored credentials cannot be decrypted without it.
DROPDRAWER_SECRET_KEY=

# Existing environment-based setups can use these bootstrap settings.
# Configure Google sign-in for clients and administrators in /admin.
DROPDRAWER_GOOGLE_CLIENT_ID=
DROPDRAWER_GOOGLE_CLIENT_SECRET=
# Example: https://drop.example.com/api/auth/google/callback
DROPDRAWER_GOOGLE_REDIRECT_URI=

# Enable /admin after creating a named account. See docs/CONFIGURATION.md.
DROPDRAWER_ADMIN_ENABLED=false

# Optional SMTP settings for email verification and password recovery.
DROPDRAWER_SMTP_HOST=
DROPDRAWER_SMTP_PORT=587
DROPDRAWER_SMTP_SECURITY=start_tls
DROPDRAWER_SMTP_USERNAME=
DROPDRAWER_SMTP_PASSWORD=
# Defaults to the SMTP username when unset.
# DROPDRAWER_SMTP_FROM=
DROPDRAWER_SMTP_FROM_NAME=DropDrawer

# Optional push notifications for phones in the background. See docs/CONFIGURATION.md.
# iOS (APNs): the .p8 key from Apple Developer > Keys, its key ID and your team ID.
DROPDRAWER_APNS_KEY_PATH=
DROPDRAWER_APNS_KEY_ID=
DROPDRAWER_APNS_TEAM_ID=
# Defaults to com.dropdrawer.ios; set it when you build the app with another bundle ID.
# DROPDRAWER_APNS_TOPIC=
# Android (FCM): the service account key file and the Android app's Firebase settings.
DROPDRAWER_FCM_SERVICE_ACCOUNT_PATH=
DROPDRAWER_FCM_APP_ID=
DROPDRAWER_FCM_API_KEY=
DROPDRAWER_FCM_SENDER_ID=
