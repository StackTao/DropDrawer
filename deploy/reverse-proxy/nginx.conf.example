# DropDrawer Nginx reverse-proxy example
# Replace drop.example.com and certificate paths with your own.
# Remember to set DROPDRAWER_TRUST_PROXY=true in DropDrawer's environment.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name drop.example.com;

    ssl_certificate     /etc/letsencrypt/live/drop.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/drop.example.com/privkey.pem;

    # Allow large file uploads (server-side limits remain enforced by DropDrawer).
    client_max_body_size 0;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;

        # Forward real client IP and scheme for rate-limiting, audit logs, and cookies.
        # DropDrawer reads only the last X-Forwarded-For entry (the one nginx appends),
        # so addresses a client puts in front of it are ignored. Behind a CDN, restore
        # the visitor's address first (set_real_ip_from + real_ip_header).
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket support (/ws).
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;

        # Stream uploads & downloads directly without buffering to proxy disk.
        proxy_request_buffering off;
        proxy_buffering         off;
        proxy_read_timeout      3600s;
        proxy_send_timeout      3600s;
    }
}
